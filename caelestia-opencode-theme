#!/usr/bin/env python3
"""Generate an OpenCode (V2) theme from the current Caelestia colour scheme.

Reads the scheme either from the ``SCHEME_COLOURS`` / ``SCHEME_MODE``
environment variables (set by Caelestia's ``theme.postHook``) or, when run
standalone, from ``~/.local/state/caelestia/scheme.json``.

Writes ``~/.config/opencode/themes/caelestia.json`` (the file name is the theme
name in OpenCode), then nudges running OpenCode TUIs with ``SIGUSR2`` so they
re-read their theme files without a restart.
"""

from __future__ import annotations

import argparse
import colorsys
import json
import os
import signal
import sys
import tempfile
from pathlib import Path

STATE = Path(os.getenv("XDG_STATE_HOME", Path.home() / ".local/state"))
CONFIG = Path(os.getenv("XDG_CONFIG_HOME", Path.home() / ".config"))
DEFAULT_SCHEME = STATE / "caelestia" / "scheme.json"
DEFAULT_OUTPUT = CONFIG / "opencode" / "themes" / "caelestia.json"

SIGUSR2 = 12
SIGUSR2_BIT = 1 << (SIGUSR2 - 1)


def hex_to_rgb(value: str) -> tuple[float, float, float]:
    value = value.lstrip("#")
    return tuple(int(value[i : i + 2], 16) / 255 for i in (0, 2, 4))  # type: ignore[return-value]


def rgb_to_hex(r: float, g: float, b: float) -> str:
    return "%02x%02x%02x" % tuple(max(0, min(255, round(x * 255))) for x in (r, g, b))


def ramp(seed: str, mode: str) -> dict[str, str]:
    """Build a 9-step hue scale from a single seed colour.

    Dark themes run light (100) -> dark (900); light themes run dark (100) ->
    light (900). Hue is preserved and saturation is kept roughly stable.
    """
    r, g, b = hex_to_rgb(seed)
    hue, _, sat = colorsys.rgb_to_hls(r, g, b)

    lightness = (
        [0.93, 0.83, 0.73, 0.63, 0.53, 0.43, 0.33, 0.23, 0.13]
        if mode == "dark"
        else [0.20, 0.30, 0.40, 0.50, 0.60, 0.70, 0.80, 0.89, 0.95]
    )

    out: dict[str, str] = {}
    for i, light in enumerate(lightness):
        s = sat
        if i <= 1:
            s = min(s, 0.60)
        elif i == 8:
            s = min(s, 0.80)
        s = max(0.16, min(0.82, s))
        out[str((i + 1) * 100)] = "#" + rgb_to_hex(*colorsys.hls_to_rgb(hue, light, s))
    return out


def gray_scale(c: dict[str, str]) -> dict[str, str]:
    """Anchor the neutral scale on the real Material surface/on-surface tones so
    the TUI background matches the rest of the desktop exactly."""
    return {
        "100": "#" + c["onSurface"],
        "200": "#" + c["onSurface"],
        "300": "#" + c["onSurfaceVariant"],
        "400": "#" + c["outline"],
        "500": "#" + c["surfaceContainerHighest"],
        "600": "#" + c["surfaceContainerHigh"],
        "700": "#" + c["surfaceContainerLow"],
        "800": "#" + c["surface"],
        "900": "#" + c["surfaceContainerLowest"],
    }


# Complete `base` token tree (mirrors OpenCode's built-in default theme).
