# Caelestia scheme role -> OpenCode hue family. Tweak these to taste.
HUE_SOURCES = {
    "red": "error",
    "orange": "tertiary",
    "green": "success",
    "cyan": "secondary",
    "blue": "term4",
    "purple": "primary",
}
ACCENT = "purple"
INTERACTIVE = "blue"


def hue_palette(c: dict[str, str], mode: str) -> dict[str, object]:
    palette: dict[str, object] = {"gray": gray_scale(c)}
    for name, role in HUE_SOURCES.items():
        palette[name] = ramp(c[role], mode)
    palette["accent"] = f"$hue.{ACCENT}"
    palette["interactive"] = f"$hue.{INTERACTIVE}"
    palette["neutral"] = "$hue.gray"
    return palette


def build(colours: dict[str, str], mode: str) -> dict[str, object]:
    # The generated file only carries the mode Caelestia is currently in; the
    # palette is emitted under that key so OpenCode resolves it correctly.
    key = "light" if mode == "light" else "dark"
    return {
        "$schema": "https://opencode.ai/theme.json",
        "base": BASE,
        key: {"hue": hue_palette(colours, mode)},
    }


def load_scheme(path: Path) -> tuple[dict[str, str], str]:
    colours_env = os.getenv("SCHEME_COLOURS")
    mode_env = os.getenv("SCHEME_MODE")
    if colours_env:
        return json.loads(colours_env), mode_env or "dark"
    data = json.loads(path.read_text())
    return data["colours"], data.get("mode", "dark")


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def nudge_opencode() -> list[int]:
    """Ask running OpenCode TUIs to re-read their theme files.

    OpenCode's TUI subscribes to ``SIGUSR2`` (the ``Theme`` store's
    ``subscribeRefresh``) and, on receipt, re-scans the global/project
    ``themes/`` directories and applies the new tokens about a second later.
    Its background service does NOT handle ``SIGUSR2``, so only processes that
    actually catch the signal are signalled (checked via ``/proc/<pid>/status``).
    """
    signalled: list[int] = []
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if pid == os.getpid():
            continue
        try:
            args = [a.decode(errors="replace") for a in (entry / "cmdline").read_bytes().split(b"\0") if a]
        except OSError:
            continue
        if not args or Path(args[0]).name != "opencode":
            continue
        try:
            status = (entry / "status").read_text()
        except OSError:
            continue
        caught = False
        for line in status.splitlines():
            if line.startswith("SigCgt:"):
                caught = bool(int(line.split()[1], 16) & SIGUSR2_BIT)
                break
        if not caught:
            continue  # e.g. `opencode serve --service`; signalling it would kill it
        try:
            os.kill(pid, SIGUSR2)
            signalled.append(pid)
        except OSError:
            pass
    return signalled


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("-s", "--scheme", type=Path, default=DEFAULT_SCHEME, help="Caelestia scheme.json to read")
    parser.add_argument("-o", "--output", type=Path, default=DEFAULT_OUTPUT, help="where to write the OpenCode theme")
    parser.add_argument("--stdout", action="store_true", help="print the theme instead of writing it")
    parser.add_argument("--no-nudge", action="store_true", help="do not signal running OpenCode TUIs")
    args = parser.parse_args(argv)

    colours, mode = load_scheme(args.scheme)
    theme = build(colours, mode)
    content = json.dumps(theme, indent=2) + "\n"

    if args.stdout:
        sys.stdout.write(content)
        return 0

    atomic_write(args.output, content)
    if not args.no_nudge:
        try:
            nudge_opencode()
        except Exception:  # never let a nudge failure break theme generation
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
